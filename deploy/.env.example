# deploy/.env — VM 에만 두고 커밋하지 않는다.
DOMAIN=example.com

POSTGRES_DB=diet
POSTGRES_USER=diet
POSTGRES_PASSWORD=

# openssl rand -hex 48 (hex 권장: base64 의 / + = 는 DATABASE_URL 을 깨뜨릴 수 있다)
JWT_SECRET=
JWT_TTL_DAYS=7

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 웹 푸시 (DEC-072·074). npx web-push@3.6.7 generate-vapid-keys 로 만든다.
# 개인키를 잃으면 모든 구독이 무효가 된다 — 이 파일을 백업할 때 같이 보관한다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
NOTIFICATIONS_ENABLED=false

# CI 가 올린 이미지 태그. 롤백은 이전 태그로 바꾸고 `docker compose up -d`
API_IMAGE=ghcr.io/chaeseungyun/diet-api:latest
WEB_IMAGE=ghcr.io/chaeseungyun/diet-web:latest

# 백업 (scripts/backup.sh)
BACKUP_PASSPHRASE=
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=7
