# deploy/.env — VM 에만 두고 커밋하지 않는다.
DOMAIN=example.com

POSTGRES_DB=diet
POSTGRES_USER=diet
POSTGRES_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=
JWT_TTL_DAYS=7

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# CI 가 올린 이미지 태그. 롤백은 이전 태그로 바꾸고 `docker compose up -d`
API_IMAGE=ghcr.io/chaeseungyun/diet-api:latest
WEB_IMAGE=ghcr.io/chaeseungyun/diet-web:latest

# 백업 (scripts/backup.sh)
BACKUP_PASSPHRASE=
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=7
