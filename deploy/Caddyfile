# HTTPS 자동 발급(Let's Encrypt). 같은 오리진에서 /api/* 만 NestJS 로 보낸다 (D-14).
# www 는 apex 로 301. DNS 는 A @ → VM IP, CNAME www → apex, 둘 다 Cloudflare 프록시 끔(DNS only).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# 업로드 크기 제한 (NFR-04). 단계 3 사진 업로드 전까지 작게 둔다.
	request_body {
		max_size 2MB
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
