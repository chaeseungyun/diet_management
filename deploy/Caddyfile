# HTTPS 자동 발급(Let's Encrypt). 같은 오리진에서 /api/* 만 NestJS 로 보낸다 (D-14).
# www 는 apex 로 301. DNS 는 A @ → VM IP, CNAME www → apex, 둘 다 Cloudflare 프록시 끔(DNS only).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# 본문 크기 제한 (NFR-04). 식사 사진 올리기만 11MB(사진 10 MB + multipart 여유, DEC-086), 나머지는 2MB.
	# 두 request_body 가 한 요청에 함께 걸리면 작은 쪽이 이기므로 조건을 서로 겹치지 않게 둔다
	@photoUpload {
		method POST
		path /api/v1/meal-photos
	}
	@notPhotoUpload {
		not {
			method POST
			path /api/v1/meal-photos
		}
	}
	request_body @photoUpload {
		max_size 11MB
	}
	request_body @notPhotoUpload {
		max_size 2MB
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
