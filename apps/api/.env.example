# NestJS API 환경 변수. 실제 값은 .env 에 두고 커밋하지 않는다(NFR-04).
NODE_ENV=development
PORT=4000

# 로컬 개발 DB (pnpm db:dev 로 embedded-postgres 실행 시 기본값)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54320/diet_dev

# JWT 서명 비밀. 32자 이상. 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_TTL_DAYS=7

# 카카오 개발자 앱 (REST API 키 / 보안 → Client Secret). 개발 중 리다이렉트 URI는 localhost (D-07·D-14)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/v1/auth/kakao/callback

# 웹 오리진. 콜백 후 302 대상이며 상태 변경 요청의 Origin 검사 기준
WEB_ORIGIN=http://localhost:3000

# 쿠키 Secure 플래그. 비우면 production 에서만 true
COOKIE_SECURE=

# 개발·테스트용 로그인(GET /api/v1/auth/dev → 'dev:tester' 계정, ?as=<name> 으로 다른 계정). production 에서는 부팅 거부
DEV_LOGIN_ENABLED=true

# Web Push VAPID 키 (DEC-072·074). 비우면 푸시가 꺼진 채로 동작한다. 만들기:
#   npx web-push@3.6.7 generate-vapid-keys
# 개인키는 비밀이다. 잃어버리면 모든 기기 구독이 무효가 되어 다시 구독해야 한다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 시 연락할 주소 (mailto: 또는 https://)
VAPID_SUBJECT=
# 알림 스케줄러(매분 판정·발송). true 면 VAPID 3개가 필요하다
NOTIFICATIONS_ENABLED=false
