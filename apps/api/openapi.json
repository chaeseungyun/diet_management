{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "프로세스·DB 상태",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/auth/kakao": {
      "get": {
        "operationId": "AuthController_start",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "카카오 로그인 시작. state 쿠키를 심고 카카오로 302",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "로그아웃 = 쿠키 삭제 (서버 상태 없음, D-07)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          }
        },
        "summary": "프로필·시간대·온보딩 완료 여부",
        "tags": [
          "me"
        ]
      },
      "patch": {
        "operationId": "MeController_update",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          }
        },
        "summary": "닉네임·시간대 수정, 온보딩 완료 표시",
        "tags": [
          "me"
        ]
      },
      "delete": {
        "operationId": "MeController_remove",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "계정 소프트 삭제. 이후 로그인·요청 거부. 개인 데이터 삭제 절차는 운영 문서",
        "tags": [
          "me"
        ]
      }
    }
  },
  "info": {
    "title": "diet-app API",
    "description": "식단·재고·체중 관리 API. 인증은 HttpOnly 쿠키의 JWT (D-07).",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nickname": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Seoul"
          },
          "onboardedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "nickname",
          "timezone",
          "onboardedAt",
          "createdAt"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "maxLength": 30,
            "example": "승윤"
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Seoul",
            "description": "IANA 시간대. 변경 시 날짜 경계와 알림 예약이 바뀐다"
          },
          "onboarded": {
            "type": "boolean",
            "description": "true 면 첫 설정(S-03) 완료로 표시한다"
          }
        }
      }
    }
  }
}
